PORT=5000
# PostgreSQL Connection URL:
# Local PostgreSQL default: postgresql://postgres:postgres@localhost:5432/land_record_db?schema=public
# Cloud (Neon / Supabase / Render): postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/land_record_db?schema=public"
JWT_SECRET=super_secret_jwt_key_land_records_2026_secure
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Real Email OTP Provider Configuration (Resend / Dev)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_NAME="ILRDVS Land Authority"
EMAIL_FROM_ADDRESS=onboarding@resend.dev
OTP_HMAC_SECRET=your_optional_hmac_secret_or_falls_back_to_jwt_secret

# Real SMS OTP Provider Configuration (MSG91 SendOTP - Legacy/Optional)
SMS_PROVIDER=msg91
SMS_PROVIDER_MODE=production
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_OTP_TEMPLATE_ID=your_msg91_dlt_template_id_here

# OTP Security & Rate Limiting Controls
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

